# ---- Meltice GPS Tracker prototype configuration -------------------------------
# Copy to .env (local) or /etc/meltice-gps-tracker/fleet.env (Hostinger) and edit.

FLEET_ENVIRONMENT_LABEL=Local
FLEET_SECRET_KEY=change-me-to-a-long-random-string
FLEET_DEBUG=false
FLEET_ALLOWED_HOSTS=127.0.0.1,localhost
# FLEET_CSRF_TRUSTED_ORIGINS=https://fleet.melticetech.com
# FLEET_BEHIND_HTTPS_PROXY=true

# First admin user (created by `manage.py ensure_admin`, only if it does not exist)
FLEET_ADMIN_USER=admin
FLEET_ADMIN_PASSWORD=change-me-now

# Load ~2 h of demo vehicles on start (docker web container / install script)
FLEET_SEED_DEMO=false

# ---- Database: sqlite (default) | mssql | postgres | mysql
FLEET_DB_ENGINE=sqlite
# FLEET_SQLITE_PATH=/var/lib/meltice-gps-tracker/fleet.sqlite3
# FLEET_DB_NAME=meltice_gps_tracker
# FLEET_DB_USER=fleet_app
# FLEET_DB_PASSWORD=
# FLEET_DB_HOST=127.0.0.1
# FLEET_DB_PORT=1433
# FLEET_DB_ODBC_DRIVER=ODBC Driver 18 for SQL Server

# ---- TCP receiver
FLEET_RECEIVER_HOST=0.0.0.0
FLEET_RECEIVER_PORT=5027
# What the FMC130 is configured with (shown in the UI): public IP / tunnel host / gps.melticetech.com
FLEET_PUBLIC_GPS_HOST=your-public-ip-or-tunnel
FLEET_PUBLIC_GPS_PORT=5027
# Where the web self-test connects (receiver as seen from the web process)
FLEET_SELFTEST_HOST=127.0.0.1
FLEET_SELFTEST_PORT=5027
FLEET_SELFTEST_IMEI=356307042441013

# ---- Hardening / behaviour
FLEET_MAX_FRAME_BYTES=65536
FLEET_MAX_CONNECTIONS=50
FLEET_CONNECTS_PER_MINUTE_PER_IP=30
FLEET_HANDSHAKE_TIMEOUT=30
FLEET_READ_TIMEOUT=360
FLEET_STALE_AFTER_SECONDS=900
FLEET_OFFLINE_AFTER_SECONDS=3600
FLEET_POLL_SECONDS=5
FLEET_DISPLAY_TZ=Asia/Dubai
